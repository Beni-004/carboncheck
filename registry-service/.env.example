# ===================================
# Registry Service Environment
# ===================================

# ===================================
# Server Configuration
# ===================================
# Local development port (Railway will use $PORT automatically)
REGISTRY_PORT=3001

# ===================================
# Database Configuration
# ===================================
# PostgreSQL connection settings
REGISTRY_DB_HOST=localhost
REGISTRY_DB_PORT=5432
REGISTRY_DB_USER=postgres
REGISTRY_DB_PASSWORD=your_password_here
REGISTRY_DB_NAME=carbon_registry

# For Railway deployment with Railway PostgreSQL:
# REGISTRY_DB_HOST=${{Postgres.PGHOST}}
# REGISTRY_DB_PORT=${{Postgres.PGPORT}}
# REGISTRY_DB_USER=${{Postgres.PGUSER}}
# REGISTRY_DB_PASSWORD=${{Postgres.PGPASSWORD}}
# REGISTRY_DB_NAME=${{Postgres.PGDATABASE}}

# ===================================
# System Configuration
# ===================================
NODE_ENV=development
SYSTEM_COUNTRY=NG
SYSTEM_COUNTRY_NAME=Nigeria
DEFAULT_CREDIT_UNIT=tCO2e

# ===================================
# Railway Deployment
# ===================================
# PORT is automatically set by Railway
# No need to set this manually
# PORT=3000
