# ===================================
# Supabase Configuration (Required)
# ===================================
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-key-here

# ===================================
# Environment Configuration
# ===================================
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO

# ===================================
# API Configuration
# ===================================
EXTERNAL_API_TIMEOUT=15
BULK_VERIFY_MAX_IDS=50

# ===================================
# CORS Configuration (Production)
# ===================================
# Frontend URL for CORS (comma-separated for multiple origins)
# Example: https://carboncheck.vercel.app
FRONTEND_URL=

# ===================================
# Sentinel Hub API (Optional)
# ===================================
# Copernicus Data Space for satellite imagery
# Register at: https://dataspace.copernicus.eu/
# Create OAuth client: Dashboard > User Settings > OAuth Clients
SENTINEL_CLIENT_ID=your-sentinel-client-id
SENTINEL_CLIENT_SECRET=your-sentinel-client-secret
SENTINEL_API_URL=https://sh.dataspace.copernicus.eu/api/v1/process

# ===================================
# Railway Deployment
# ===================================
# PORT is automatically set by Railway
# No need to set this manually
# PORT=8000
