from fastapi import APIRouter, Query, status
from typing import Optional, Literal
from app.schemas import LeaderboardResponse, LeaderboardEntry
from app.db import get_db_client
from datetime import datetime
import logging

logger = logging.getLogger(__name__)

router = APIRouter()


@router.get(
    "/leaderboard",
    response_model=LeaderboardResponse,
    status_code=status.HTTP_200_OK,
    summary="Get public leaderboard",
    description=(
        "Retrieve ranked carbon credit leaderboard (worst scores first). "
        "Supports filtering by project type and result limiting."
    ),
)
async def get_leaderboard(
    project_type: Optional[Literal["forestry", "renewable", "soil", "other"]] = Query(
        None,
        description="Filter by project type category"
    ),
    limit: int = Query(
        100,
        ge=1,
        le=500,
        description="Maximum number of results to return"
    ),
) -> LeaderboardResponse:
    """
    Get public leaderboard endpoint.
    
    Query Parameters:
        - project_type: Optional filter by category
        - limit: Max results (1-500, default 100)
    
    Returns:
        LeaderboardResponse with ranked entries
    """
    logger.info(f"GET /api/leaderboard - project_type={project_type}, limit={limit}")
    
    db = get_db_client()
    
    # Build query
    query = db.client.table("leaderboard_cache").select("*")
    
    # Apply project_type filter if provided
    if project_type:
        query = query.eq("project_type", project_type)
    
    # Order by rank (lowest score = rank 1 = first)
    query = query.order("rank_overall", desc=False).limit(limit)
    
    # Execute query
    try:
        result = query.execute()
        
        entries_data = result.data if result.data else []
        
        # Get refresh timestamp (from first entry or use current time)
        refreshed_at = datetime.utcnow()
        if entries_data:
            refreshed_at = datetime.fromisoformat(
                entries_data[0]["refreshed_at"].replace("Z", "+00:00")
            )
        
        # Convert to LeaderboardEntry schemas
        entries = [
            LeaderboardEntry(
                project_id=entry["project_id"],
                project_type=entry["project_type"],
                total_score=float(entry["total_score"]),
                verdict=entry["verdict"],
                registry_name=entry["registry_name"],
                claimed_tco2=float(entry["claimed_tco2"]),
                rank_overall=entry["rank_overall"],
                rank_in_category=entry["rank_in_category"],
            )
            for entry in entries_data
        ]
        
        # Get total count (for pagination metadata)
        total_count_query = db.client.table("leaderboard_cache").select("id", count="exact")
        if project_type:
            total_count_query = total_count_query.eq("project_type", project_type)
        
        total_count_result = total_count_query.execute()
        total_entries = total_count_result.count if hasattr(total_count_result, "count") else len(entries)
        
        logger.info(
            f"GET /api/leaderboard - Returned {len(entries)} entries "
            f"(total={total_entries}, filter={project_type})"
        )
        
        return LeaderboardResponse(
            entries=entries,
            refreshed_at=refreshed_at,
            total_entries=total_entries,
            filter_applied=project_type,
        )
    
    except Exception as e:
        logger.error(f"GET /api/leaderboard - Error: {e}")
        # Return empty response on error (graceful degradation)
        return LeaderboardResponse(
            entries=[],
            refreshed_at=datetime.utcnow(),
            total_entries=0,
            filter_applied=project_type,
        )
