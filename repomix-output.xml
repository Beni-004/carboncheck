"""
Base HTTP client with fixed 3-second timeout and structured error handling.
All external API clients must inherit from BaseClient.
"""

import httpx
import logging
from typing import Optional, Dict, Any
from datetime import datetime

logger = logging.getLogger(__name__)

# Fixed timeout for all external API calls (non-negotiable)
EXTERNAL_API_TIMEOUT = 3.0


class ClientError(Exception):
    """
    Base exception for client errors.
    Used to distinguish client failures from application errors.
    """
    def __init__(self, source_name: str, message: str, original_error: Optional[Exception] = None):
        self.source_name = source_name
        self.message = message
        self.original_error = original_error
        super().__init__(f"[{source_name}] {message}")


class ClientTimeout(ClientError):
    """
    Exception raised when external API call times out.
    Signals that fallback cache should be used.
    """
    pass


class BaseClient:
    """
    Base HTTP client with timeout enforcement and error handling.
    
    Design principles:
    - Fixed 3-second timeout (non-configurable)
    - Structured exception handling (timeout vs other errors)
    - Request/response logging for audit trail
    - No automatic retries (fallback to cache instead)
    """
    
    def __init__(self, source_name: str, base_url: Optional[str] = None):
        """
        Initialize base client.
        
        Args:
            source_name: Name of external source (for logging/error tracking)
            base_url: Base URL for API (optional, can be set per-request)
        """
        self.source_name = source_name
        self.base_url = base_url
        self._client = httpx.AsyncClient(
            timeout=EXTERNAL_API_TIMEOUT,
            follow_redirects=True,
        )
    
    async def close(self):
        """Close HTTP client session."""
        await self._client.aclose()
    
    async def __aenter__(self):
        """Async context manager entry."""
        return self
    
    async def __aexit__(self, exc_type, exc_val, exc_tb):
        """Async context manager exit."""
        await self.close()
    
    async def get(
        self,
        path: str,
        params: Optional[Dict[str, Any]] = None,
        headers: Optional[Dict[str, str]] = None,
    ) -> Dict[str, Any]:
        """
        Execute GET request with timeout and error handling.
        
        Args:
            path: URL path (relative to base_url or absolute)
            params: Query parameters
            headers: Request headers
        
        Returns:
            Parsed JSON response as dict
        
        Raises:
            ClientTimeout: If request times out (>3 seconds)
            ClientError: If request fails for other reasons
        """
        url = self._build_url(path)
        request_start = datetime.utcnow()
        
        try:
            logger.info(f"[{self.source_name}] GET {url} params={params}")
            
            response = await self._client.get(
                url,
                params=params,
                headers=headers,
            )
            
            elapsed_ms = (datetime.utcnow() - request_start).total_seconds() * 1000
            logger.info(f"[{self.source_name}] Response {response.status_code} in {elapsed_ms:.0f}ms")
            
            response.raise_for_status()
            return response.json()
        
        except httpx.TimeoutException as e:
            elapsed_ms = (datetime.utcnow() - request_start).total_seconds() * 1000
            logger.warning(
                f"[{self.source_name}] Timeout after {elapsed_ms:.0f}ms (limit={EXTERNAL_API_TIMEOUT}s)"
            )
            raise ClientTimeout(
                source_name=self.source_name,
                message=f"Request timed out after {EXTERNAL_API_TIMEOUT}s",
                original_error=e,
            )
        
        except httpx.HTTPStatusError as e:
            logger.error(
                f"[{self.source_name}] HTTP {e.response.status_code}: {e.response.text[:200]}"
            )
            raise ClientError(
                source_name=self.source_name,
                message=f"HTTP {e.response.status_code}: {e.response.text[:100]}",
                original_error=e,
            )
        
        except httpx.RequestError as e:
            logger.error(f"[{self.source_name}] Request failed: {str(e)}")
            raise ClientError(
                source_name=self.source_name,
                message=f"Request failed: {str(e)}",
                original_error=e,
            )
        
        except Exception as e:
            logger.error(f"[{self.source_name}] Unexpected error: {str(e)}")
            raise ClientError(
                source_name=self.source_name,
                message=f"Unexpected error: {str(e)}",
                original_error=e,
            )
    
    async def post(
        self,
        path: str,
        data: Optional[Dict[str, Any]] = None,
        json: Optional[Dict[str, Any]] = None,
        headers: Optional[Dict[str, str]] = None,
    ) -> Dict[str, Any]:
        """
        Execute POST request with timeout and error handling.
        
        Args:
            path: URL path (relative to base_url or absolute)
            data: Form data
            json: JSON body
            headers: Request headers
        
        Returns:
            Parsed JSON response as dict
        
        Raises:
            ClientTimeout: If request times out (>3 seconds)
            ClientError: If request fails for other reasons
        """
        url = self._build_url(path)
        request_start = datetime.utcnow()
        
        try:
            logger.info(f"[{self.source_name}] POST {url}")
            
            response = await self._client.post(
                url,
                data=data,
                json=json,
                headers=headers,
            )
            
            elapsed_ms = (datetime.utcnow() - request_start).total_seconds() * 1000
            logger.info(f"[{self.source_name}] Response {response.status_code} in {elapsed_ms:.0f}ms")
            
            response.raise_for_status()
            return response.json()
        
        except httpx.TimeoutException as e:
            elapsed_ms = (datetime.utcnow() - request_start).total_seconds() * 1000
            logger.warning(
                f"[{self.source_name}] Timeout after {elapsed_ms:.0f}ms (limit={EXTERNAL_API_TIMEOUT}s)"
            )
            raise ClientTimeout(
                source_name=self.source_name,
                message=f"Request timed out after {EXTERNAL_API_TIMEOUT}s",
                original_error=e,
            )
        
        except httpx.HTTPStatusError as e:
            logger.error(
                f"[{self.source_name}] HTTP {e.response.status_code}: {e.response.text[:200]}"
            )
            raise ClientError(
                source_name=self.source_name,
                message=f"HTTP {e.response.status_code}: {e.response.text[:100]}",
                original_error=e,
            )
        
        except httpx.RequestError as e:
            logger.error(f"[{self.source_name}] Request failed: {str(e)}")
            raise ClientError(
                source_name=self.source_name,
                message=f"Request failed: {str(e)}",
                original_error=e,
            )
        
        except Exception as e:
            logger.error(f"[{self.source_name}] Unexpected error: {str(e)}")
            raise ClientError(
                source_name=self.source_name,
                message=f"Unexpected error: {str(e)}",
                original_error=e,
            )
    
    def _build_url(self, path: str) -> str:
        """
        Build full URL from base_url and path.
        
        Args:
            path: URL path (can be absolute or relative)
        
        Returns:
            Full URL
        """
        if path.startswith("http://") or path.startswith("https://"):
            return path
        
        if self.base_url:
            return f"{self.base_url.rstrip('/')}/{path.lstrip('/')}"
        
        return path
