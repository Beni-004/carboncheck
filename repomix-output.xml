"""
Trust Score Repository
Manages persistence of trust scores to Supabase trust_scores table.
"""

from typing import Dict, Any, Optional
from datetime import datetime
from app.db import get_db_client
import logging
import json

logger = logging.getLogger(__name__)


class TrustScoreRepository:
    """
    Repository for trust_scores table operations.
    
    Responsibilities:
    - Insert computed trust scores
    - Query historical scores
    - Update batch rankings
    """
    
    def __init__(self):
        self.db = get_db_client()
        self.table = "trust_scores"
    
    async def save_trust_score(
        self,
        score_data: Dict[str, Any],
    ) -> bool:
        """
        Save computed trust score to database.
        
        Args:
            score_data: Trust score data (from scoring engine)
        
        Returns:
            True if successful, False otherwise
        """
        try:
            # Build trust_scores row
            row = {
                "project_id": score_data["project_id"],
                "total_score": float(score_data["total_score"]),
                "baseline_match_score": float(score_data["score_breakdown"]["baseline_match"]),
                "additionality_score": float(score_data["score_breakdown"]["additionality"]),
                "permanence_risk_score": float(score_data["score_breakdown"]["permanence_risk"]),
                "double_counting_score": float(score_data["score_breakdown"]["double_counting"]),
                "verdict": score_data["verdict"],
                "fallback_used": score_data["fallback_used"],
                "data_mode": score_data["data_mode"],
                "source_snapshot_hash": score_data["source_snapshot_hash"],
                "audit_trail": json.dumps(score_data["audit_trail"]),
                "rank_in_batch": score_data.get("rank_in_batch"),
                "computed_at": score_data["computed_at"].isoformat(),
            }
            
            # Insert into database
            result = (
                self.db.client
                .table(self.table)
                .insert(row)
                .execute()
            )
            
            logger.info(
                f"[TrustScoreRepository] Saved trust score for {score_data['project_id']}: "
                f"score={score_data['total_score']:.2f}, verdict={score_data['verdict']}"
            )
            
            return True
        
        except Exception as e:
            logger.error(
                f"[TrustScoreRepository] Error saving trust score for "
                f"{score_data.get('project_id', 'unknown')}: {e}"
            )
            return False
    
    async def get_latest_score(
        self,
        project_id: str,
    ) -> Optional[Dict[str, Any]]:
        """
        Retrieve latest trust score for a project.
        
        Args:
            project_id: Project identifier
        
        Returns:
            Trust score record or None if not found
        """
        try:
            result = (
                self.db.client
                .table(self.table)
                .select("*")
                .eq("project_id", project_id)
                .order("computed_at", desc=True)
                .limit(1)
                .execute()
            )
            
            if not result.data:
                return None
            
            return result.data[0]
        
        except Exception as e:
            logger.error(
                f"[TrustScoreRepository] Error retrieving score for {project_id}: {e}"
            )
            return None


# Global repository instance
_trust_score_repository: Optional[TrustScoreRepository] = None


def get_trust_score_repository() -> TrustScoreRepository:
    """
    Get global trust score repository instance (singleton).
    
    Returns:
        TrustScoreRepository instance
    """
    global _trust_score_repository
    if _trust_score_repository is None:
        _trust_score_repository = TrustScoreRepository()
    return _trust_score_repository
