    steps:
      - uses: actions/checkout@v3

      - name: Set up Rust
        uses: actions-rs/toolchain@v1
        with:
          toolchain: stable

      - name: Build
        run: cd apps/api && cargo build --release

      - name: Run tests
        run: cd apps/api && cargo test --release

      - name: Build Docker image
        run: |
          cd apps/api
          docker build -t carboncheck-api:latest -f docker/Dockerfile .
          docker tag carboncheck-api:latest carboncheck-api:${{ github.sha }}

      - name: Push to registry
        run: |
          echo "${{ secrets.DOCKER_PASSWORD }}" | docker login -u "${{ secrets.DOCKER_USERNAME }}" --password-stdin
          docker push carboncheck-api:latest
          docker push carboncheck-api:${{ github.sha }}

      - name: Deploy to Kubernetes
        run: |
          kubectl set image deployment/carboncheck-api carboncheck-api=carboncheck-api:${{ github.sha }}
          kubectl rollout status deployment/carboncheck-api
