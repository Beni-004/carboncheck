      vintage: 2022,
      co2Equivalent: 500,
      fraudRisks: [
        {
          category: "Double Counting",
          severity: "medium",
          description:
            "Credit appears in multiple registries simultaneously",
          evidence: "Registry cross-check flagged duplicate entries",
