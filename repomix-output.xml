openapi: 3.1.0
info:
  title: CarbonCheck API
  version: 0.1.0
  description: |
    Trust scoring and public leaderboard API.
    Design constraints:
    - External API timeout per source: 3 seconds
    - Supabase cache fallback when upstream source fails
    - Never return HTTP 500
servers:
  - url: https://api.carboncheck.example

tags:
  - name: Verify
  - name: Leaderboard
  - name: Health

paths:
  /api/verify:
    post:
      tags: [Verify]
      summary: Verify one or many carbon credit IDs
      description: |
        Accepts either a single credit_id or up to 50 credit_ids.
        Returns deterministic score breakdown over four checks.
      operationId: verifyCredits
      requestBody:
        required: true
        content:
          application/json:
            schema:
              oneOf:
                - $ref: '#/components/schemas/VerifySingleRequest'
                - $ref: '#/components/schemas/VerifyBulkRequest'
      responses:
        '200':
          description: Successful verification response
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/VerifyResponse'
        '400':
          description: Invalid payload shape
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/ErrorResponse'
        '422':
          description: Validation failed for one or more IDs
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/ErrorResponse'
        '429':
          description: Rate limit exceeded
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/ErrorResponse'
        '503':
          description: Degraded service with no scoreable data (still non-500)
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/ErrorResponse'

  /api/leaderboard:
    get:
      tags: [Leaderboard]
      summary: Fetch public leaderboard of most-flagged credits
      operationId: getLeaderboard
      parameters:
        - name: credit_type
          in: query
          required: false
          schema:
            type: string
            enum: [Forestry, Renewable, Soil]
        - name: limit
          in: query
          required: false
          schema:
            type: integer
            minimum: 1
            maximum: 100
            default: 25
      responses:
        '200':
          description: Leaderboard snapshot
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/LeaderboardResponse'
        '429':
          description: Rate limit exceeded
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/ErrorResponse'
        '503':
          description: Cache unavailable/degraded (still non-500)
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/ErrorResponse'

  /api/health:
    get:
      tags: [Health]
      summary: Service and dependency health
      operationId: getHealth
      responses:
        '200':
          description: Healthy or degraded but serving
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/HealthResponse'
        '503':
          description: Critical dependency failure (service intentionally degraded)
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/HealthResponse'

components:
  schemas:
    VerifySingleRequest:
      type: object
      additionalProperties: false
      required: [credit_id]
      properties:
        credit_id:
          type: string
          minLength: 3
          maxLength: 128

    VerifyBulkRequest:
      type: object
      additionalProperties: false
      required: [credit_ids]
      properties:
        credit_ids:
          type: array
          minItems: 1
          maxItems: 50
          items:
            type: string
            minLength: 3
            maxLength: 128

    VerifyResponse:
      type: object
      additionalProperties: false
      required:
        - request_id
        - mode
        - data_mode
        - fallback_used
        - timeout_seconds
        - results
        - errors
      properties:
        request_id:
          type: string
          format: uuid
        mode:
          type: string
          enum: [single, bulk]
        data_mode:
          type: string
          enum: [live, mixed, cache]
        fallback_used:
          type: boolean
        timeout_seconds:
          type: integer
          const: 3
        results:
          type: array
          items:
            $ref: '#/components/schemas/VerifyResult'
        errors:
          type: array
          items:
            $ref: '#/components/schemas/ItemError'

    VerifyResult:
      type: object
      additionalProperties: false
      required:
        - credit_id
        - trust_score
        - verdict
        - rank
        - checks
        - evidence_summary
        - provenance
      properties:
        credit_id:
          type: string
        trust_score:
          type: number
          minimum: 0
          maximum: 100
        verdict:
          type: string
          enum: [FAIL, WARNING, PASS, UNSCORED]
        rank:
          type: integer
          minimum: 1
          nullable: true
        checks:
          type: object
          additionalProperties: false
          required: [baseline_match, additionality, permanence_risk, double_counting]
          properties:
            baseline_match:
              $ref: '#/components/schemas/CheckMetric'
            additionality:
              $ref: '#/components/schemas/CheckMetric'
            permanence_risk:
              $ref: '#/components/schemas/CheckMetric'
            double_counting:
              $ref: '#/components/schemas/CheckMetric'
        evidence_summary:
          type: string
          minLength: 1
        provenance:
          type: array
          minItems: 1
          items:
            $ref: '#/components/schemas/SourceProvenance'

    CheckMetric:
      type: object
      additionalProperties: false
      required: [score, weight]
      properties:
        score:
          type: number
          minimum: 0
          maximum: 100
        weight:
          type: number
          enum: [0.30, 0.25, 0.20]

    SourceProvenance:
      type: object
      additionalProperties: false
      required: [source, fetched_at, freshness_state, from_cache]
      properties:
        source:
          type: string
          enum: [ember_api, cea, grid_india, rec_registry]
        fetched_at:
          type: string
          format: date-time
        freshness_state:
          type: string
          enum: [fresh, stale, missing]
        from_cache:
          type: boolean

    ItemError:
      type: object
      additionalProperties: false
      required: [credit_id, code, message]
      properties:
        credit_id:
          type: string
        code:
          type: string
          enum: [INVALID_ID, UNKNOWN_ID, UNSCORED_NO_DATA]
        message:
          type: string

    LeaderboardResponse:
      type: object
      additionalProperties: false
      required: [snapshot_at, freshness_state, items]
      properties:
        snapshot_at:
          type: string
          format: date-time
        freshness_state:
          type: string
          enum: [fresh, stale, degraded]
        items:
          type: array
          items:
            $ref: '#/components/schemas/LeaderboardItem'

    LeaderboardItem:
      type: object
      additionalProperties: false
      required:
        - credit_id
        - credit_type
        - flagged_count_24h
        - avg_trust_score_24h
        - current_verdict
        - rank_global
        - rank_by_type
        - evidence_snippet
      properties:
        credit_id:
          type: string
        credit_type:
          type: string
          enum: [Forestry, Renewable, Soil]
        flagged_count_24h:
          type: integer
          minimum: 0
        avg_trust_score_24h:
          type: number
          minimum: 0
          maximum: 100
        current_verdict:
          type: string
          enum: [FAIL, WARNING, PASS, UNSCORED]
        rank_global:
          type: integer
          minimum: 1
        rank_by_type:
          type: integer
          minimum: 1
        evidence_snippet:
          type: string

    HealthResponse:
      type: object
      additionalProperties: false
      required: [status, service, dependencies]
      properties:
        status:
          type: string
          enum: [healthy, degraded, unavailable]
        service:
          type: string
          enum: [carboncheck-api]
        dependencies:
          type: object
          additionalProperties: false
          required: [supabase, ember_api, cea, grid_india, rec_registry]
          properties:
            supabase:
              $ref: '#/components/schemas/DependencyState'
            ember_api:
              $ref: '#/components/schemas/DependencyState'
            cea:
              $ref: '#/components/schemas/DependencyState'
            grid_india:
              $ref: '#/components/schemas/DependencyState'
            rec_registry:
              $ref: '#/components/schemas/DependencyState'

    DependencyState:
      type: object
      additionalProperties: false
      required: [status, timeout_seconds]
      properties:
        status:
          type: string
          enum: [up, down, timeout, degraded]
        timeout_seconds:
          type: integer
          const: 3

    ErrorResponse:
      type: object
      additionalProperties: false
      required: [status, code, message, request_id]
      properties:
        status:
          type: string
          enum: [error, degraded]
        code:
          type: string
        message:
          type: string
        request_id:
          type: string
          format: uuid
</file>

<file path="specs/001-carboncheck-trust-journeys/data-model.md">
# Phase 1 Data Model - CarbonCheck Trust Journeys

## Schema Principles
- Deterministic scoring snapshots: all score rows capture exact check values and source snapshot hash.
- Rigid constraints: strict enums, bounded ranges, non-nullable core fields, and uniqueness guarantees.
- Read optimization: leaderboard served from precomputed cache table.

## Table: carbon_credits
Canonical registry metadata plus source freshness references.

| Column | Type | Constraints | Notes |
|---|---|---|---|
| id | uuid | PK, default gen_random_uuid() | Internal key |
| credit_id | text | NOT NULL, UNIQUE, CHECK (length(credit_id) between 3 and 128) | User-facing ID |
| project_name | text | NOT NULL | Credit project name |
| credit_type | text | NOT NULL, CHECK (credit_type in ('Forestry','Renewable','Soil')) | Leaderboard grouping |
| issuer | text | NOT NULL | Registry/issuer label |
| vintage_year | int | NOT NULL, CHECK (vintage_year between 1990 and 2100) | Domain bound |
| country_code | text | NOT NULL, CHECK (char_length(country_code)=2) | ISO-2 style |
| status | text | NOT NULL, CHECK (status in ('active','retired','suspended','unknown')) | Current lifecycle |
| source_embr_fetched_at | timestamptz | NULL | Latest Ember fetch |
| source_cea_fetched_at | timestamptz | NULL | Latest CEA fetch |
| source_grid_india_fetched_at | timestamptz | NULL | Latest Grid-India fetch |
| source_rec_registry_fetched_at | timestamptz | NULL | Latest REC Registry fetch |
| cache_stale_after | timestamptz | NOT NULL | Freshness threshold for fallback |
| created_at | timestamptz | NOT NULL, default now() | Audit |
| updated_at | timestamptz | NOT NULL, default now() | Audit |

Indexes:
- idx_carbon_credits_credit_type (credit_type)
- idx_carbon_credits_cache_stale_after (cache_stale_after)

## Table: trust_scores
Per-request deterministic output for one credit_id with full check breakdown.

| Column | Type | Constraints | Notes |
|---|---|---|---|
| id | uuid | PK, default gen_random_uuid() | Internal key |
| request_id | uuid | NOT NULL | Correlates API request |
| carbon_credit_id | uuid | NOT NULL, FK -> carbon_credits(id) ON DELETE CASCADE | Subject credit |
| baseline_match | numeric(5,2) | NOT NULL, CHECK (baseline_match between 0 and 100) | Check score |
| additionality | numeric(5,2) | NOT NULL, CHECK (additionality between 0 and 100) | Check score |
| permanence_risk | numeric(5,2) | NOT NULL, CHECK (permanence_risk between 0 and 100) | Check score (higher is safer after normalization) |
| double_counting | numeric(5,2) | NOT NULL, CHECK (double_counting between 0 and 100) | Check score |
| trust_score | numeric(5,2) | NOT NULL, CHECK (trust_score between 0 and 100) | Weighted total |
| verdict | text | NOT NULL, CHECK (verdict in ('FAIL','WARNING','PASS','UNSCORED')) | User-visible class |
| rank_in_batch | int | NULL, CHECK (rank_in_batch > 0) | Present in bulk mode |
| data_mode | text | NOT NULL, CHECK (data_mode in ('live','mixed','cache')) | Provenance mode |
| fallback_used | boolean | NOT NULL, default false | Any source fallback occurred |
| source_snapshot_hash | text | NOT NULL | Determinism anchor |
| evidence_summary | text | NOT NULL | Explainability snippet |
| error_code | text | NULL | Domain error (never 500) |
| created_at | timestamptz | NOT NULL, default now() | Audit |

Indexes:
- idx_trust_scores_credit_created (carbon_credit_id, created_at desc)
- idx_trust_scores_request_id (request_id)
- idx_trust_scores_verdict_created (verdict, created_at desc)

## Table: leaderboard_cache
Public read model, refreshed by scheduler.

| Column | Type | Constraints | Notes |
|---|---|---|---|
| id | uuid | PK, default gen_random_uuid() | Internal key |
| credit_id | text | NOT NULL | Denormalized for fast UI |
| credit_type | text | NOT NULL, CHECK (credit_type in ('Forestry','Renewable','Soil')) | Category |
| flagged_count_24h | int | NOT NULL, CHECK (flagged_count_24h >= 0) | Rolling indicator |
| avg_trust_score_24h | numeric(5,2) | NOT NULL, CHECK (avg_trust_score_24h between 0 and 100) | Trend signal |
| current_verdict | text | NOT NULL, CHECK (current_verdict in ('FAIL','WARNING','PASS','UNSCORED')) | Snapshot verdict |
| rank_global | int | NOT NULL, CHECK (rank_global > 0) | Overall rank |
| rank_by_type | int | NOT NULL, CHECK (rank_by_type > 0) | Per-category rank |
| evidence_snippet | text | NOT NULL | Public explanation |
| snapshot_at | timestamptz | NOT NULL | Cache build time |
| freshness_state | text | NOT NULL, CHECK (freshness_state in ('fresh','stale','degraded')) | Display label |

Constraints:
- UNIQUE (snapshot_at, credit_type, rank_by_type)
- UNIQUE (snapshot_at, rank_global)

Indexes:
- idx_leaderboard_cache_snapshot_type_rank (snapshot_at desc, credit_type, rank_by_type)
- idx_leaderboard_cache_snapshot_global_rank (snapshot_at desc, rank_global)

## Derived Rules
- Verdict mapping:
  - FAIL: trust_score < 40
  - WARNING: trust_score >= 40 and trust_score < 70
  - PASS: trust_score >= 70
- Weighted total:
  - trust_score = round((baseline_match*0.30 + additionality*0.25 + permanence_risk*0.25 + double_counting*0.20), 2)

## State Transitions
- carbon_credits.status:
  - unknown -> active|suspended|retired
  - active -> suspended|retired
  - suspended -> active|retired
  - retired -> retired (terminal)
- freshness_state in leaderboard_cache:
  - fresh -> stale when snapshot age exceeds SLA
  - stale -> degraded if one or more upstream sources unavailable in latest refresh
  - degraded -> fresh when all upstream sources healthy and refresh succeeds
</file>

