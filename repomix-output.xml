    - On successful external API call: write to cache (upsert)
    - On timeout/error: read from cache (last known value)
    - Cache entries include source name, fetch timestamp, and data
    """
    
    def __init__(self):
        self.db = get_db_client()
        self.cache_table = "source_data_cache"
    
    async def get_cached_value(
        self,
        cache_key: str,
        source_name: str,
    ) -> Optional[Dict[str, Any]]:
        """
        Retrieve cached value for a source data lookup.
        
        Args:
            cache_key: Unique key for cached entry (e.g., "ember:grid:IN-MH:2023")
            source_name: Name of external source (for logging)
        
        Returns:
            Dict with cached data and metadata, or None if not found
            Structure:
                - data: Cached data payload
                - fetched_at: Original fetch timestamp
                - cache_age_seconds: Age of cached data
        """
        try:
            result = (
                self.db.client
                .table(self.cache_table)
                .select("*")
                .eq("cache_key", cache_key)
                .order("fetched_at", desc=True)
                .limit(1)
                .execute()
            )
            
            if not result.data:
                logger.info(f"[Cache] No cached value found for key={cache_key}")
                return None
            
            cached_entry = result.data[0]
            fetched_at = datetime.fromisoformat(cached_entry["fetched_at"].replace("Z", "+00:00"))
            cache_age = (datetime.utcnow() - fetched_at).total_seconds()
            
            logger.info(
                f"[Cache] Retrieved cached value for {source_name} "
                f"(age={cache_age:.0f}s, key={cache_key})"
            )
            
            return {
                "data": json.loads(cached_entry["data"]) if isinstance(cached_entry["data"], str) else cached_entry["data"],
                "fetched_at": fetched_at,
                "cache_age_seconds": int(cache_age),
            }
        
        except Exception as e:
            logger.error(f"[Cache] Error retrieving cached value for key={cache_key}: {e}")
            return None
    
    async def set_cached_value(
        self,
        cache_key: str,
        source_name: str,
        data: Dict[str, Any],
        fetched_at: Optional[datetime] = None,
    ) -> bool:
        """
        Store/update cached value for a source data lookup.
        
        Args:
            cache_key: Unique key for cached entry
            source_name: Name of external source
            data: Data payload to cache
            fetched_at: Timestamp of fetch (defaults to now)
        
        Returns:
            True if successful, False otherwise
        """
        if fetched_at is None:
            fetched_at = datetime.utcnow()
        
        try:
            # Upsert cached entry
            cache_entry = {
                "cache_key": cache_key,
                "source_name": source_name,
                "data": json.dumps(data) if not isinstance(data, str) else data,
                "fetched_at": fetched_at.isoformat(),
                "updated_at": datetime.utcnow().isoformat(),
            }
            
            result = (
                self.db.client
                .table(self.cache_table)
                .upsert(cache_entry, on_conflict="cache_key")
                .execute()
            )
            
            logger.info(f"[Cache] Stored cached value for {source_name} (key={cache_key})")
            return True
        
        except Exception as e:
            logger.error(f"[Cache] Error storing cached value for key={cache_key}: {e}")
            return False
    
    def build_cache_key(
        self,
        source_name: str,
        lookup_type: str,
        **params: Any,
    ) -> str:
        """
        Build deterministic cache key from source name, lookup type, and parameters.
        
        Args:
            source_name: External source name (e.g., "Ember", "CEA")
            lookup_type: Type of lookup (e.g., "grid_generation", "mandate_status")
            **params: Lookup parameters (e.g., project_id, location, year)
        
        Returns:
            Cache key string (e.g., "ember:grid_generation:IN-MH:2023")
        """
        # Sort params for deterministic key
        sorted_params = sorted(params.items())
        param_str = ":".join(f"{k}={v}" for k, v in sorted_params if v is not None)
        
        key = f"{source_name.lower()}:{lookup_type}"
        if param_str:
            key += f":{param_str}"
        
        return key


# Global cache repository instance
cache_repository = CacheRepository()


def get_cache_repository() -> CacheRepository:
    """
    Dependency injection helper for services.
    Returns the global cache repository instance.
    """
    return cache_repository
