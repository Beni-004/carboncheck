"""
Verify Service
Orchestrates single and bulk credit verification with scoring engine integration.
"""

from typing import List, Dict, Any
from app.scoring.engine import ScoringEngine, get_scoring_engine
from app.schemas import VerifyRequest, VerifyResponse, TrustScoreResult, VerifyErrorDetail
import logging

logger = logging.getLogger(__name__)


class VerifyService:
    """
    Service for credit verification (single and bulk).
    
    Responsibilities:
    - Validate input project IDs
    - Orchestrate scoring engine calls
    - Handle partial failures (bulk mode)
    - Return structured results + errors
    """
    
    def __init__(self, scoring_engine: ScoringEngine = None):
        """
        Initialize verify service.
        
        Args:
            scoring_engine: Scoring engine instance (defaults to global)
        """
        self.scoring_engine = scoring_engine or get_scoring_engine()
    
    async def verify_credits(
        self,
        request: VerifyRequest,
    ) -> VerifyResponse:
        """
        Verify one or more carbon credits.
        
        Args:
            request: VerifyRequest with project_ids (1-50 items)
        
        Returns:
            VerifyResponse with results and errors
        """
        project_ids = request.project_ids
        total_requested = len(project_ids)
        
        logger.info(f"[VerifyService] Verifying {total_requested} project(s)")
        
        results = []
        errors = []
        
        # Determine if bulk mode (affects ranking)
        is_bulk = total_requested > 1
        
        # Process each project ID
        for idx, project_id in enumerate(project_ids):
            try:
                # Compute trust score
                rank_in_batch = idx + 1 if is_bulk else None
                
                score_data = await self.scoring_engine.compute_trust_score(
                    project_id=project_id,
                    rank_in_batch=rank_in_batch,
                )
                
                # Convert to TrustScoreResult schema
                result = TrustScoreResult(**score_data)
                results.append(result)
            
            except ValueError as e:
                # Project not found or invalid
                logger.warning(f"[VerifyService] Verification failed for {project_id}: {e}")
                errors.append(VerifyErrorDetail(
                    project_id=project_id,
                    error_code="PROJECT_NOT_FOUND",
                    error_message=str(e),
                ))
            
            except Exception as e:
                # Unexpected error (should be rare due to fallback strategy)
                logger.error(f"[VerifyService] Unexpected error for {project_id}: {e}")
                errors.append(VerifyErrorDetail(
                    project_id=project_id,
                    error_code="VERIFICATION_ERROR",
                    error_message=f"Verification failed: {str(e)}",
                ))
        
        # Sort results by score (lowest = riskiest first) for bulk mode
        if is_bulk and results:
            results.sort(key=lambda r: r.total_score)
            # Update rank_in_batch after sorting
            for idx, result in enumerate(results):
                result.rank_in_batch = idx + 1
        
        total_succeeded = len(results)
        total_failed = len(errors)
        
        logger.info(
            f"[VerifyService] Verification complete: "
            f"{total_succeeded} succeeded, {total_failed} failed"
        )
        
        return VerifyResponse(
            results=results,
            errors=errors,
            total_requested=total_requested,
            total_succeeded=total_succeeded,
            total_failed=total_failed,
        )


# Global verify service instance
_verify_service: VerifyService = None


def get_verify_service() -> VerifyService:
    """
    Get global verify service instance (singleton).
    
    Returns:
        VerifyService instance
    """
    global _verify_service
    if _verify_service is None:
        _verify_service = VerifyService()
