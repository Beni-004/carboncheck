"""
Four-Check Scoring Engine
Orchestrates 4-component trust score computation with external source integration.
"""

from typing import Dict, Any, Optional, List
from datetime import datetime
from app.scoring.scoring import compute_score, ScoreResult
from app.scoring.constants import compute_verdict, compute_data_mode
from app.clients.ember_client import EmberClient
from app.clients.cea_client import CEAClient
from app.clients.grid_india_client import GridIndiaClient
from app.clients.rec_registry_client import RECRegistryClient
from app.services.cache_repository import CacheRepository, get_cache_repository
from app.schemas import SourceProvenance
import logging
import hashlib
import json

logger = logging.getLogger(__name__)


class ScoringEngine:
    """
    Four-check scoring engine with external source integration and cache fallback.
    
    Workflow:
    1. Fetch data from external sources (Ember, CEA, Grid-India, REC Registry)
    2. On timeout/error, fallback to cached values
    3. Compute 4-component score using fetched/cached data
    4. Track provenance and data mode (live/cached/partial)
    5. Return structured score result with audit trail
    """
    
    def __init__(
        self,
        ember_client: Optional[EmberClient] = None,
        cea_client: Optional[CEAClient] = None,
        grid_india_client: Optional[GridIndiaClient] = None,
        rec_registry_client: Optional[RECRegistryClient] = None,
        cache_repository: Optional[CacheRepository] = None,
    ):
        """
        Initialize scoring engine with external clients and cache repository.
        
        Args:
            ember_client: Ember API client (for grid generation data)
            cea_client: CEA API client (for mandate status)
            grid_india_client: Grid-India API client (for fire risk)
            rec_registry_client: REC Registry API client (for project data)
            cache_repository: Cache repository for fallback
        """
        self.ember_client = ember_client or EmberClient()
        self.cea_client = cea_client or CEAClient()
        self.grid_india_client = grid_india_client or GridIndiaClient()
        self.rec_registry_client = rec_registry_client or RECRegistryClient()
        self.cache = cache_repository or get_cache_repository()
    
    async def compute_trust_score(
        self,
        project_id: str,
        rank_in_batch: Optional[int] = None,
    ) -> Dict[str, Any]:
        """
        Compute complete trust score for a project with external source integration.
        
        Args:
            project_id: Project identifier
            rank_in_batch: Rank within bulk batch (None for single verify)
        
        Returns:
            Dict with trust score result and metadata
        """
        logger.info(f"[ScoringEngine] Computing trust score for project_id={project_id}")
        
        # Step 1: Fetch project details from REC Registry
        project_data = await self._fetch_project_data(project_id)
        
        if not project_data:
            raise ValueError(f"Project {project_id} not found in registry")
        
        # Step 2: Fetch external source data (with cache fallback)
        sources_data = await self._fetch_external_sources(project_id, project_data)
        
        # Step 3: Compute 4-component score
        score_result = compute_score(
            project_id=project_id,
            claimed_tco2=project_data["claimed_tco2"],
            actual_grid_tco2=sources_data["actual_grid_tco2"],
            is_mandated=sources_data["is_mandated"],
            project_type=project_data["project_type"],
            fire_risk_index=sources_data["fire_risk_index"],
            registry_count=sources_data["registry_count"],
        )
        
        # Step 4: Compute verdict and data mode
        verdict = compute_verdict(score_result.total_score)
        fallback_used = any(sources_data["sources_used_cache"])
        data_mode = compute_data_mode(sources_data["sources_used_cache"])
        
        # Step 5: Build provenance tracking
        provenance = self._build_provenance(sources_data)
        
        # Step 6: Generate source snapshot hash
        snapshot_hash = self._generate_snapshot_hash(sources_data)
        
        # Step 7: Build result envelope
        result = {
            "project_id": project_id,
            "total_score": score_result.total_score,
            "verdict": verdict,
            "score_breakdown": {
                "baseline_match": score_result.baseline_match.score,
                "additionality": score_result.additionality.score,
                "permanence_risk": score_result.permanence_risk.score,
                "double_counting": score_result.double_counting.score,
            },
            "fallback_used": fallback_used,
            "data_mode": data_mode,
            "source_provenance": provenance,
            "computed_at": datetime.utcnow(),
            "rank_in_batch": rank_in_batch,
            "source_snapshot_hash": snapshot_hash,
            "audit_trail": score_result.audit_trail,
        }
        
        logger.info(
            f"[ScoringEngine] Score computed for {project_id}: "
            f"total={score_result.total_score:.2f}, verdict={verdict}, "
            f"fallback_used={fallback_used}, data_mode={data_mode}"
        )
        
        return result
    
    async def _fetch_project_data(self, project_id: str) -> Optional[Dict[str, Any]]:
        """
        Fetch project data from REC Registry (with cache fallback).
        
        Returns:
            Dict with project details or None if not found
        """
        cache_key = self.cache.build_cache_key(
            source_name="REC-Registry",
            lookup_type="project_details",
            project_id=project_id,
        )
        
        # Try live API call
        project_data = await self.rec_registry_client.get_project_details(project_id)
        
        if project_data:
            # Cache successful result
            await self.cache.set_cached_value(
                cache_key=cache_key,
                source_name="REC-Registry",
                data=project_data,
            )
            return project_data
        
        # Fallback to cache
        cached = await self.cache.get_cached_value(cache_key, "REC-Registry")
        if cached:
            logger.warning(f"[ScoringEngine] Using cached project data for {project_id}")
            return cached["data"]
        
        return None
    
    async def _fetch_external_sources(
        self,
        project_id: str,
        project_data: Dict[str, Any],
    ) -> Dict[str, Any]:
        """
        Fetch data from all external sources (Ember, CEA, Grid-India, REC Registry).
        On timeout/error, fallback to cached values.
        
        Returns:
            Dict with all source data and cache usage flags
        """
        location = project_data.get("location")
        project_type = project_data["project_type"]
        vintage_year = project_data.get("vintage_year")
        
        sources_data = {
            "actual_grid_tco2": None,
            "is_mandated": False,
            "fire_risk_index": None,
            "registry_count": 1,
            "sources_used_cache": [],
            "sources_metadata": [],
        }
        
        # Fetch 1: Ember (grid generation)
        ember_data, ember_cached = await self._fetch_with_fallback(
            fetch_fn=lambda: self.ember_client.get_grid_generation(
                project_id, location, vintage_year
            ),
            cache_key=self.cache.build_cache_key(
                "Ember", "grid_generation",
                location=location, year=vintage_year
            ),
            source_name="Ember",
        )
        
        if ember_data:
            sources_data["actual_grid_tco2"] = ember_data.get("actual_grid_tco2")
            sources_data["sources_metadata"].append({
                "source_name": "Ember",
                "fetched_at": ember_data.get("fetched_at"),
                "cached": ember_cached,
            })
        sources_data["sources_used_cache"].append(ember_cached)
        
        # Fetch 2: CEA (mandate status)
        cea_data, cea_cached = await self._fetch_with_fallback(
            fetch_fn=lambda: self.cea_client.check_mandate_status(
                project_id, project_type, location, vintage_year
            ),
            cache_key=self.cache.build_cache_key(
                "CEA", "mandate_status",
                project_id=project_id, project_type=project_type
            ),
            source_name="CEA",
        )
        
        if cea_data:
            sources_data["is_mandated"] = cea_data.get("is_mandated", False)
            sources_data["sources_metadata"].append({
                "source_name": "CEA",
                "fetched_at": cea_data.get("fetched_at"),
                "cached": cea_cached,
            })
        sources_data["sources_used_cache"].append(cea_cached)
        
        # Fetch 3: Grid-India (fire risk - only for forestry)
        if project_type == "forestry":
            grid_data, grid_cached = await self._fetch_with_fallback(
                fetch_fn=lambda: self.grid_india_client.get_fire_risk_index(
                    project_id, location
                ),
                cache_key=self.cache.build_cache_key(
                    "Grid-India", "fire_risk",
                    location=location
                ),
                source_name="Grid-India",
            )
            
            if grid_data:
                sources_data["fire_risk_index"] = grid_data.get("fire_risk_index")
                sources_data["sources_metadata"].append({
                    "source_name": "Grid-India",
                    "fetched_at": grid_data.get("fetched_at"),
                    "cached": grid_cached,
                })
            sources_data["sources_used_cache"].append(grid_cached)
        
        # Fetch 4: REC Registry (double counting check)
        rec_data, rec_cached = await self._fetch_with_fallback(
            fetch_fn=lambda: self.rec_registry_client.get_project_registrations(
                project_id
            ),
            cache_key=self.cache.build_cache_key(
                "REC-Registry", "registrations",
                project_id=project_id
            ),
            source_name="REC-Registry",
        )
        
        if rec_data:
            sources_data["registry_count"] = rec_data.get("registry_count", 1)
            sources_data["sources_metadata"].append({
                "source_name": "REC-Registry",
                "fetched_at": rec_data.get("fetched_at"),
                "cached": rec_cached,
            })
        sources_data["sources_used_cache"].append(rec_cached)
        
        return sources_data
    
    async def _fetch_with_fallback(
        self,
        fetch_fn,
        cache_key: str,
        source_name: str,
    ) -> tuple[Optional[Dict[str, Any]], bool]:
        """
        Execute fetch function with automatic cache fallback.
        
        Args:
            fetch_fn: Async function that fetches from external source
            cache_key: Cache key for fallback lookup
            source_name: Source name for logging
        
        Returns:
            Tuple of (data, used_cache_flag)
        """
        # Try live API call
        data = await fetch_fn()
        
        if data:
            # Cache successful result
            await self.cache.set_cached_value(
                cache_key=cache_key,
                source_name=source_name,
                data=data,
            )
            return (data, False)
        
        # Fallback to cache
        cached = await self.cache.get_cached_value(cache_key, source_name)
        if cached:
            logger.warning(f"[ScoringEngine] Using cached data for {source_name}")
            return (cached["data"], True)
        
        return (None, True)
    
    def _build_provenance(self, sources_data: Dict[str, Any]) -> List[Dict[str, Any]]:
        """
        Build provenance tracking list from sources metadata.
        
        Returns:
            List of SourceProvenance dicts
        """
        provenance = []
        
        for meta in sources_data["sources_metadata"]:
            provenance.append({
                "source_name": meta["source_name"],
                "fetched_at": meta["fetched_at"],
                "freshness_state": "cached" if meta["cached"] else "live",
                "cache_age_seconds": None if not meta["cached"] else None,  # TODO: add cache age
            })
        
        return provenance
    
    def _generate_snapshot_hash(self, sources_data: Dict[str, Any]) -> str:
        """
        Generate deterministic hash of source data snapshot.
        
        Purpose: Enable repeatability - same inputs always produce same hash.
        
        Returns:
            SHA-256 hash of source data
        """
        # Build deterministic snapshot representation
        snapshot = {
            "actual_grid_tco2": sources_data["actual_grid_tco2"],
            "is_mandated": sources_data["is_mandated"],
            "fire_risk_index": sources_data["fire_risk_index"],
            "registry_count": sources_data["registry_count"],
        }
        
        # Sort keys for determinism
        snapshot_json = json.dumps(snapshot, sort_keys=True)
        
        # Generate SHA-256 hash
        hash_obj = hashlib.sha256(snapshot_json.encode())
        return hash_obj.hexdigest()


# Global scoring engine instance
