"""
Leaderboard Refresh Service
Refreshes leaderboard_cache table from trust_scores for public leaderboard.
"""

from typing import Optional, List, Dict, Any
from datetime import datetime
from app.db import get_db_client
import logging

logger = logging.getLogger(__name__)


class LeaderboardRefreshService:
    """
    Service for refreshing leaderboard cache.
    
    Workflow:
    1. Query latest trust_scores (one per project)
    2. Rank by total_score (lowest = worst)
    3. Calculate overall and category ranks
    4. Upsert into leaderboard_cache
    """
    
    def __init__(self):
        self.db = get_db_client()
    
    async def refresh_leaderboard(self) -> Dict[str, int]:
        """
        Refresh leaderboard cache from latest trust scores.
        
        Returns:
            Dict with refresh statistics (total_entries, categories_updated)
        """
        logger.info("[LeaderboardRefresh] Starting leaderboard refresh...")
        
        # Step 1: Get latest trust scores (one per project)
        latest_scores = await self._get_latest_scores()
        
        if not latest_scores:
            logger.warning("[LeaderboardRefresh] No trust scores found - skipping refresh")
            return {"total_entries": 0, "categories_updated": 0}
        
        # Step 2: Rank overall (lowest score = rank 1)
        sorted_scores = sorted(latest_scores, key=lambda x: x["total_score"])
        
        for idx, score in enumerate(sorted_scores):
            score["rank_overall"] = idx + 1
        
        # Step 3: Rank by category
        categories = set(score["project_type"] for score in sorted_scores)
        
        for category in categories:
            category_scores = [s for s in sorted_scores if s["project_type"] == category]
            category_sorted = sorted(category_scores, key=lambda x: x["total_score"])
            
            for idx, score in enumerate(category_sorted):
                score["rank_in_category"] = idx + 1
        
        # Step 4: Clear existing cache and insert new rankings
        await self._clear_cache()
        
        refreshed_at = datetime.utcnow()
        entries_inserted = 0
        
        for score in sorted_scores:
            success = await self._insert_cache_entry(score, refreshed_at)
            if success:
                entries_inserted += 1
        
        logger.info(
            f"[LeaderboardRefresh] Refresh complete: "
            f"{entries_inserted} entries, {len(categories)} categories"
        )
        
        return {
            "total_entries": entries_inserted,
            "categories_updated": len(categories),
        }
    
    async def _get_latest_scores(self) -> List[Dict[str, Any]]:
        """
        Get latest trust score for each project.
        
        Returns:
            List of trust score records with project metadata
        """
        try:
            # Query trust_scores joined with carbon_credits for metadata
            result = (
                self.db.client
                .rpc("get_latest_trust_scores")  # Use stored procedure for efficiency
                .execute()
            )
            
            if result.data:
                return result.data
            
            # Fallback: manual query if stored procedure not available
            scores_result = (
                self.db.client
                .table("trust_scores")
                .select("*")
                .order("computed_at", desc=True)
                .execute()
            )
            
            # Deduplicate by project_id (keep latest)
            seen_projects = set()
            latest_scores = []
            
            for score in scores_result.data:
                if score["project_id"] not in seen_projects:
                    seen_projects.add(score["project_id"])
                    latest_scores.append(score)
            
            # Fetch carbon_credits metadata for each project
            for score in latest_scores:
                credit_result = (
                    self.db.client
                    .table("carbon_credits")
                    .select("project_type, registry_name, claimed_tco2")
                    .eq("project_id", score["project_id"])
                    .limit(1)
                    .execute()
                )
                
                if credit_result.data:
                    credit = credit_result.data[0]
                    score["project_type"] = credit["project_type"]
                    score["registry_name"] = credit["registry_name"]
                    score["claimed_tco2"] = credit["claimed_tco2"]
            
            return latest_scores
        
        except Exception as e:
            logger.error(f"[LeaderboardRefresh] Error fetching latest scores: {e}")
            return []
    
    async def _clear_cache(self) -> bool:
        """
        Clear existing leaderboard cache.
        
        Returns:
            True if successful
        """
        try:
            self.db.client.table("leaderboard_cache").delete().neq("id", "00000000-0000-0000-0000-000000000000").execute()
            logger.info("[LeaderboardRefresh] Cleared existing leaderboard cache")
            return True
        except Exception as e:
            logger.error(f"[LeaderboardRefresh] Error clearing cache: {e}")
            return False
    
    async def _insert_cache_entry(
        self,
        score: Dict[str, Any],
        refreshed_at: datetime,
    ) -> bool:
        """
        Insert single entry into leaderboard cache.
        
        Args:
            score: Trust score record with rankings
            refreshed_at: Refresh timestamp
        
        Returns:
            True if successful
        """
        try:
            entry = {
                "project_id": score["project_id"],
                "project_type": score.get("project_type", "other"),
                "total_score": float(score["total_score"]),
                "verdict": score["verdict"],
                "registry_name": score.get("registry_name", "Unknown"),
                "claimed_tco2": float(score.get("claimed_tco2", 0)),
                "rank_overall": score["rank_overall"],
                "rank_in_category": score["rank_in_category"],
                "refreshed_at": refreshed_at.isoformat(),
            }
            
            self.db.client.table("leaderboard_cache").insert(entry).execute()
            return True
        
        except Exception as e:
            logger.error(
                f"[LeaderboardRefresh] Error inserting cache entry for "
                f"{score.get('project_id', 'unknown')}: {e}"
            )
            return False


# Global service instance
_leaderboard_refresh_service: Optional[LeaderboardRefreshService] = None


def get_leaderboard_refresh_service() -> LeaderboardRefreshService:
    """
    Get global leaderboard refresh service instance (singleton).
    
    Returns:
        LeaderboardRefreshService instance
    """
    global _leaderboard_refresh_service
    if _leaderboard_refresh_service is None:
        _leaderboard_refresh_service = LeaderboardRefreshService()
    return _leaderboard_refresh_service
