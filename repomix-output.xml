"""
Global Exception Mapper Middleware
NEVER returns HTTP 500 - all errors are mapped to domain error envelopes.
"""

from fastapi import Request, status
from fastapi.responses import JSONResponse
from datetime import datetime
import logging
import traceback

logger = logging.getLogger(__name__)


async def error_handler_middleware(request: Request, call_next):
    """
    Global error handler middleware that catches all exceptions
    and maps them to appropriate HTTP status codes (NEVER 500).
    
    Strategy:
    - Validation errors -> 400 Bad Request
    - Not found errors -> 404 Not Found
    - Client errors -> 400 Bad Request
    - Unexpected errors -> 503 Service Unavailable (with degraded mode message)
    
    NEVER return HTTP 500 to maintain demo reliability.
    """
    try:
        response = await call_next(request)
        return response
    
    except Exception as e:
        # Log full traceback for debugging
        logger.error(
            f"Unhandled exception in {request.method} {request.url.path}: {str(e)}\n"
            f"{traceback.format_exc()}"
        )
        
        # Determine appropriate status code and error response
        error_response = _map_exception_to_response(e, request)
        
        return JSONResponse(
            status_code=error_response["status_code"],
            content=error_response["body"],
        )


def _map_exception_to_response(exception: Exception, request: Request) -> dict:
    """
    Map exception to appropriate HTTP status code and error body.
    
    Args:
        exception: Caught exception
        request: FastAPI request object
    
    Returns:
        Dict with "status_code" and "body" keys
    """
    timestamp = datetime.utcnow().isoformat() + "Z"
    
    # Import here to avoid circular dependency
    from pydantic import ValidationError
    
    # Pydantic validation errors -> 400 Bad Request
    if isinstance(exception, ValidationError):
        return {
            "status_code": status.HTTP_400_BAD_REQUEST,
            "body": {
                "error_code": "VALIDATION_ERROR",
                "error_message": "Request validation failed",
                "details": exception.errors(),
                "timestamp": timestamp,
            }
        }
    
    # Value errors (domain validation) -> 400 Bad Request
    if isinstance(exception, ValueError):
        return {
            "status_code": status.HTTP_400_BAD_REQUEST,
            "body": {
                "error_code": "INVALID_INPUT",
                "error_message": str(exception),
                "timestamp": timestamp,
            }
        }
    
    # Key errors (missing required data) -> 400 Bad Request
    if isinstance(exception, KeyError):
        return {
            "status_code": status.HTTP_400_BAD_REQUEST,
            "body": {
                "error_code": "MISSING_FIELD",
                "error_message": f"Missing required field: {str(exception)}",
                "timestamp": timestamp,
            }
        }
    
    # All other unexpected errors -> 503 Service Unavailable (degraded mode)
    # This maintains demo reliability by avoiding 500 errors
    logger.error(
        f"Mapping unexpected {type(exception).__name__} to 503 Service Unavailable: {str(exception)}"
    )
    
    return {
        "status_code": status.HTTP_503_SERVICE_UNAVAILABLE,
        "body": {
            "error_code": "SERVICE_DEGRADED",
            "error_message": (
                "Service is temporarily degraded. "
                "Request was received but could not be fully processed. "
                "Cached data may be returned where available."
            ),
            "details": {
                "exception_type": type(exception).__name__,
                "path": str(request.url.path),
            },
            "timestamp": timestamp,
        }
    }
