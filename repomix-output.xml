````python
"""
Scoring Engine - 4-component trust score computation
Each component 0–25 points, total 0–100.

Components:
1. baseline_match (0–25): Claimed tCO2 vs actual grid generation
2. additionality (0–25): Project mandated without credits? 0=yes, 25=no
3. permanence_risk (0–25): Forestry=fire risk index. Renewable=20 default
4. double_counting (0–25): Same project ID in 2+ registries = 0. Unique = 25
"""

from dataclasses import dataclass
from typing import Optional, Literal
import logging

logger = logging.getLogger(__name__)


@dataclass
class ScoreComponent:
    """Individual score component (0–25 points)"""
    name: Literal["baseline_match", "additionality", "permanence_risk", "double_counting"]
    score: float  # 0–25
    source: Literal["api", "cached"]  # Track data provenance
    metadata: Optional[dict] = None


@dataclass
class ScoreResult:
    """
    Final trust score result (0–100).
    All components must be present; fallback to cached values on external API failure.
    """
    project_id: str
    total_score: float  # 0–100
    baseline_match: ScoreComponent
    additionality: ScoreComponent
    permanence_risk: ScoreComponent
    double_counting: ScoreComponent
    audit_trail: dict  # Captures decisions for transparency


def compute_score(
    project_id: str,
    claimed_tco2: float,
    actual_grid_tco2: Optional[float],
    is_mandated: bool,
    project_type: Literal["forestry", "renewable", "other"],
    fire_risk_index: Optional[float],
    registry_count: int,
    cached_scores: Optional[dict] = None,
) -> ScoreResult:
    """
    Compute 4-component trust score with fallback to cached values on API failure.

    Args:
        project_id: Unique project identifier
        claimed_tco2: Claimed tCO2 reduction from project
        actual_grid_tco2: Actual grid generation from Ember/Grid-India (if available)
        is_mandated: Whether project was mandated without credits
        project_type: "forestry", "renewable", or "other"
        fire_risk_index: Fire risk for forestry (0–100), None for others
        registry_count: Number of registries listing this project
        cached_scores: Previously computed scores for fallback

    Returns:
        ScoreResult with 4 components, total score, and audit trail
    """
    audit_trail = {
        "inputs": {
            "project_id": project_id,
            "claimed_tco2": claimed_tco2,
            "is_mandated": is_mandated,
            "project_type": project_type,
            "registry_count": registry_count,
        },
        "computation": {}
    }

    # Component 1: Baseline Match (0–25)
    baseline_match = _compute_baseline_match(
        claimed_tco2, actual_grid_tco2, audit_trail
    )

    # Component 2: Additionality (0–25)
    additionality = _compute_additionality(is_mandated, audit_trail)

    # Component 3: Permanence Risk (0–25)
    permanence_risk = _compute_permanence_risk(
        project_type, fire_risk_index, audit_trail
    )

    # Component 4: Double Counting (0–25)
    double_counting = _compute_double_counting(registry_count, audit_trail)

    # Total score
    total_score = (
        baseline_match.score +
        additionality.score +
        permanence_risk.score +
        double_counting.score
    )

    audit_trail["computation"]["total_score"] = total_score

    return ScoreResult(
        project_id=project_id,
        total_score=total_score,
        baseline_match=baseline_match,
        additionality=additionality,
        permanence_risk=permanence_risk,
        double_counting=double_counting,
        audit_trail=audit_trail,
    )


def _compute_baseline_match(
    claimed_tco2: float,
    actual_grid_tco2: Optional[float],
    audit_trail: dict,
) -> ScoreComponent:
    """
    Baseline Match (0–25): Compare claimed vs actual grid generation.
    - If actual_grid_tco2 available: score = 25 * (min(claimed, actual) / max(claimed, actual))
    - If not available: use cached or default 12.5
    """
    if actual_grid_tco2 is not None and actual_grid_tco2 > 0:
        ratio = min(claimed_tco2, actual_grid_tco2) / max(claimed_tco2, actual_grid_tco2)
        score = 25 * ratio
        source = "api"
        metadata = {
            "claimed_tco2": claimed_tco2,
            "actual_grid_tco2": actual_grid_tco2,
            "ratio": ratio,
        }
        audit_trail["computation"]["baseline_match"] = metadata
    else:
        # Fallback: conservative middle score
        score = 12.5
        source = "cached"
