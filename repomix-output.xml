"""
Health Router
Handles GET /api/health endpoint for system health checks.
"""

from fastapi import APIRouter, status
from app.schemas import HealthResponse, DependencyHealth
from app.db import get_db_client
from datetime import datetime
import logging

logger = logging.getLogger(__name__)

router = APIRouter()


@router.get(
    "/health",
    response_model=HealthResponse,
    status_code=status.HTTP_200_OK,
    summary="System health check",
    description=(
        "Check health status of API and all dependencies "
        "(database, external sources, cache)."
    ),
)
async def health_check() -> HealthResponse:
    """
    System health check endpoint.
    
    Returns:
        HealthResponse with overall status and dependency details
    """
    logger.info("GET /api/health - Starting health check")
    
    checked_at = datetime.utcnow()
    dependencies = []
    
    # Check 1: Supabase database
    db_health = await _check_database_health()
    dependencies.append(db_health)
    
    # Check 2: External API sources (placeholder - would actually ping each)
    # For hackathon: assume healthy if no recent errors logged
    dependencies.extend([
        DependencyHealth(
            name="ember_api",
            status="healthy",  # Placeholder
            latency_ms=None,
            last_checked=checked_at,
            error_message=None,
        ),
        DependencyHealth(
            name="cea_api",
            status="healthy",  # Placeholder
            latency_ms=None,
            last_checked=checked_at,
            error_message=None,
        ),
        DependencyHealth(
            name="grid_india_api",
            status="healthy",  # Placeholder
            latency_ms=None,
            last_checked=checked_at,
            error_message=None,
        ),
        DependencyHealth(
            name="rec_registry_api",
            status="healthy",  # Placeholder
            latency_ms=None,
            last_checked=checked_at,
            error_message=None,
        ),
    ])
    
    # Determine overall status
    statuses = [dep.status for dep in dependencies]
    
    if all(s == "healthy" for s in statuses):
        overall_status = "healthy"
    elif any(s == "unavailable" for s in statuses):
        overall_status = "degraded"
    else:
        overall_status = "degraded"
    
    logger.info(f"GET /api/health - Overall status: {overall_status}")
    
    return HealthResponse(
        status=overall_status,
        version="1.0.0",
        dependencies=dependencies,
        checked_at=checked_at,
    )


async def _check_database_health() -> DependencyHealth:
    """
    Check Supabase database connectivity.
    
    Returns:
        DependencyHealth for database
    """
    start_time = datetime.utcnow()
    
    try:
        db = get_db_client()
        is_healthy = db.health_check()
        
        elapsed_ms = int((datetime.utcnow() - start_time).total_seconds() * 1000)
        
        if is_healthy:
            return DependencyHealth(
                name="supabase",
                status="healthy",
                latency_ms=elapsed_ms,
                last_checked=datetime.utcnow(),
                error_message=None,
            )
        else:
            return DependencyHealth(
                name="supabase",
                status="unavailable",
                latency_ms=elapsed_ms,
                last_checked=datetime.utcnow(),
                error_message="Database connection failed",
            )
    
    except Exception as e:
        elapsed_ms = int((datetime.utcnow() - start_time).total_seconds() * 1000)
        logger.error(f"Database health check failed: {e}")
        
        return DependencyHealth(
            name="supabase",
            status="unavailable",
            latency_ms=elapsed_ms,
            last_checked=datetime.utcnow(),
            error_message=str(e),
        )
