pub struct VerificationService;

impl VerificationService {
    pub fn verify_single(credit_id: &str) -> TrustScoreResult {
        // Known test cases
        match credit_id {
            "VCS-2024-001" => Self::create_pass_result(credit_id),
            "GOLD-2023-556" => Self::create_warning_result(credit_id),
            "ACR-2021-999" => Self::create_fail_result(credit_id),
            _ => Self::create_random_result(credit_id),
        }
    }

    pub fn verify_bulk(credit_ids: Vec<String>) -> BulkVerifyResult {
        let mut results = Vec::new();
        let mut errors = Vec::new();

        for id in credit_ids.iter() {
            // Simulate 5% error rate
            if rand::random::<f64>() < 0.05 {
                errors.push(VerifyError {
                    creditId: id.clone(),
                    error: "Invalid credit ID format or not found in registry".to_string(),
                });
            } else {
                results.push(Self::verify_single(id));
            }
        }

        // Sort by score ascending (worst first)
        results.sort_by_key(|r| r.trustScore);

        BulkVerifyResult {
            totalSubmitted: credit_ids.len(),
            totalProcessed: results.len(),
            totalErrors: errors.len(),
            errors: if errors.is_empty() { None } else { Some(errors) },
            results,
        }
    }

    pub fn get_leaderboard(category: Option<String>, limit: usize) -> LeaderboardResponse {
        let categories = vec![
            "Renewable Energy",
            "Forestry",
            "Landfill Gas",
            "Methane",
            "Soil Carbon",
        ];

        let issuers = vec![
            "Verified Carbon Standard",
            "Gold Standard",
            "American Carbon Registry",
            "Climate Action Reserve",
        ];

        let mut rng = rand::thread_rng();
        let mut entries: Vec<LeaderboardEntry> = (0..100)
            .map(|i| {
                let score = rng.gen_range(0..100);
                let cat_idx = rng.gen_range(0..categories.len());
                let cat = categories[cat_idx];
                let issuer_idx = rng.gen_range(0..issuers.len());

                LeaderboardEntry {
                    creditId: format!(
                        "{}-{}-{:03}",
                        &cat[0..3].to_uppercase(),
                        2020 + (i / 20),
                        i + 1
                    ),
                    trustScore: score,
                    verdict: if score > 70 {
                        "PASS".to_string()
                    } else if score > 40 {
                        "WARNING".to_string()
                    } else {
                        "FAIL".to_string()
                    },
                    category: cat.to_string(),
                    issuer: issuers[issuer_idx].to_string(),
                    flagCount: ((100 - score) / 10 + rng.gen_range(0..5)) as u32,
                    lastVerified: Utc::now()
                        - chrono::Duration::seconds(rng.gen_range(0..604800) as i64),
                }
            })
            .collect();

        // Filter by category if provided
        if let Some(cat) = category {
            entries.retain(|e| e.category == cat);
        }

        // Sort by flag count descending (most flagged first)
        entries.sort_by(|a, b| b.flagCount.cmp(&a.flagCount));

        let total = entries.len();
        entries.truncate(limit);

        LeaderboardResponse {
            entries,
            totalCount: total,
            lastUpdated: Utc::now(),
        }
    }

