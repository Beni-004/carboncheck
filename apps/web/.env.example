# Frontend Environment Variables
# Copy this to .env.local and update with your backend URLs

# ===================================
# Backend API URLs
# ===================================

# Main CarbonCheck Backend API (Required)
# For local development:
NEXT_PUBLIC_API_URL=http://localhost:8000
# For production (Railway):
# NEXT_PUBLIC_API_URL=https://carboncheck-backend.railway.app

# Integration Layer API (Optional - for registry integration)
# For local development:
NEXT_PUBLIC_INTEGRATION_API_URL=http://localhost:8001
# For production (Railway):
# NEXT_PUBLIC_INTEGRATION_API_URL=https://carboncheck-integration.railway.app

# Registry Service API (Optional - for direct registry access)
# For local development:
NEXT_PUBLIC_REGISTRY_API_URL=http://localhost:3001
# For production (Railway):
# NEXT_PUBLIC_REGISTRY_API_URL=https://carboncheck-registry.railway.app

# ===================================
# Deployment Notes
# ===================================
# - All NEXT_PUBLIC_* variables are exposed to the browser
# - Never put secrets in NEXT_PUBLIC_* variables
# - Set these in Vercel dashboard under Project Settings > Environment Variables
# - Required for production: NEXT_PUBLIC_API_URL
# - Optional for production: NEXT_PUBLIC_INTEGRATION_API_URL, NEXT_PUBLIC_REGISTRY_API_URL
